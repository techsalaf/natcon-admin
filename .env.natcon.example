# Create .env.natcon locally or on the host. It is ignored by Git.
NATCON_DSN=mysql:host=127.0.0.1;dbname=natcon;charset=utf8mb4
NATCON_DB_USER=natcon
NATCON_DB_PASSWORD=replace-with-a-long-password
NATCON_BASE_URL=https://natcon.my360school.com
PAYSTACK_SECRET_KEY=sk_live_replace_only_on_the_server
NATCON_MAIL_FROM=tickets@your-domain.example
# Optional, 0 means no capacity cap.
NATCON_CAPACITY=0
# Local time in Africa/Lagos.
NATCON_REGISTRATION_CLOSES=2026-10-04 23:59:59
