Options -Indexes
DirectoryIndex index.php

# Only the NATCON entry points are public. The purchased legacy source remains
# available for maintenance, but its unauthenticated APIs must not be exposed.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Route only legacy Flutter API requests to the allowlisted NATCON adapter.
    # The purchased PHP endpoints themselves remain inaccessible.
    RewriteRule ^(user_api|orag_api)/([A-Za-z0-9_/-]+\.php)$ api/mobile.php?client=$1&endpoint=$2 [QSA,L]
    RewriteRule ^(?:\.git|\.github|services|db|docs|scripts|tests|filemanager|user_api|orag_api|qr|old|natcon-user-app|natcon-organizer-app)(?:/|$) - [F,L,NC]
    RewriteRule ^assets/.*\.php$ - [F,L,NC]
    RewriteRule ^(?:conference|operations)/.*(?:test|eval|README|package|node_modules)(?:[./]|$) - [F,L,NC]
</IfModule>

<FilesMatch "(?i)(^\.|\.(?:sql|log|ini|env|bak|sqlite|sqlite3|db|md|ya?ml|lock|ps1|py)$)">
    Require all denied
</FilesMatch>
<FilesMatch "^(?!index\.php$|natcon\.php$|mobile\.php$|ticket\.php$|certificate\.php$|privacy\.php$)[^/]+\.php$">
    Require local
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>
